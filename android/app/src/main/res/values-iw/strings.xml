    <string name="pp_overview">סקירה כללית</string>
    <string name="pp_overview_1">LibrePods אינה אוספת, שומרת, מוכרת או משתפת מידע אישי לצורכי פרסום, ניתוח נתונים, מעקב או בניית פרופילים. האפליקציה אינה כוללת כלי ניתוח, דיווח קריסות, טלמטריה, ערכות פרסום (SDK) או שירותי מעקב.</string>
    <string name="pp_overview_2">כל המידע נשאר במכשיר שלך, אלא אם תבחר במפורש ליצור איתי קשר, לפתוח דיווח תקלה ב-GitHub מתוך האפליקציה, או לבצע רכישה או חסות דרך פלטפורמת צד שלישי.</string>
    <string name="pp_third_party">שירותי צד שלישי</string>
    <string name="pp_third_party_desc">LibrePods מספקת מספר דרכים ליצירת קשר איתי, כולל דואר אלקטרוני, דיסקורד ודיווח תקלות ב-GitHub.</string>
    <string name="pp_email">דואר אלקטרוני</string>
    <string name="pp_email_1">אם תיצור איתי קשר בדואר אלקטרוני, אקבל את כתובת הדואר האלקטרוני שלך וכל מידע שתבחר לכלול בהודעה. בעת שימוש בטופס יצירת הקשר ב-LibrePods, אפליקציית הדואר שלך תיפתח עם כתובת נמען, נושא ותוכן שמילאת מראש. גוף ההודעה יכלול גם מידע על גרסת LibrePods ועל המכשיר, כדי לסייע בפתרון תקלות.</string>
    <string name="pp_email_2">ניתן לערוך או להסיר כל מידע זה לפני שליחת ההודעה.</string>
    <string name="pp_discord">דיסקורד</string>
    <string name="pp_discord_1">האפליקציה מספקת קישור לשרת הדיסקורד של LibrePods. אם תבחר להצטרף לשרת, תהיה כפוף למדיניות הפרטיות של דיסקורד.</string>
    <string name="pp_discord_2">איני מקבל מדיסקורד מידע עליך מלבד מה שגלוי לכולם בשרת, כגון שם המשתמש, תאריך ההצטרפות, שרתים משותפים וכל הודעה או תוכן שתפרסם בשרת, אלא אם תבחר לשתף איתי מידע בשרת.</string>
    <string name="pp_github_issues">דיווח תקלות ב-GitHub</string>
    <string name="pp_github_1">בעת פתיחת דיווח תקלה ב-GitHub דרך LibrePods, האפליקציה תמלא מראש את טופס הדיווח עם:</string>
    <string name="pp_github_item_version">• שם הגרסה וקוד הגרסה של LibrePods</string>
    <string name="pp_github_item_device">• יצרן ודגם המכשיר</string>
    <string name="pp_github_item_build">• פרטי גרסת האנדרואיד</string>
    <string name="pp_github_item_source">• מקור ההתקנה (Google Play או GitHub)</string>
    <string name="pp_github_2">מידע זה מסייע באבחון תקלות ובמתן תמיכה. שום מידע אינו נשלח אוטומטית. המידע נשלח רק אם תבחר לפתוח את דיווח התקלה ב-GitHub.</string>
    <string name="pp_payments">תשלומים</string>
    <string name="pp_google_play">Google Play</string>
    <string name="pp_play_1">בעת שימוש בגרסה הזמינה ב-Google Play, הרכישות מעובדות על ידי Google Play.</string>
    <string name="pp_play_2">LibrePods מאמתת את הרכישה מול Google Play במכשיר עצמו, ולא מול שרת מרוחק שבשליטתי. איני מקבל מ-Google Play מידע עליך או על הרכישה שלך. עיבוד התשלום מתבצע במלואו על ידי Google Play, ואין לי גישה לפרטי התשלום שלך.</string>
    <string name="pp_github_sponsors">GitHub Sponsors</string>
    <string name="pp_sponsors_1">בעת שימוש בגרסת ה-FOSS הזמינה ב-GitHub, כפתור השדרוג מקשר ל-GitHub Sponsors. אם תבחר לתמוך ב-LibrePods, התמיכה שלך מעובדת על ידי GitHub.</string>
    <string name="pp_sponsors_2">שם המשתמש והמדינה/אזור שלך משותפים איתי כאשר אתה תומך ב-LibrePods. בהתאם להגדרות הפרטיות שלך ב-GitHub Sponsors, ייתכן שאקבל גם את כתובת הדואר האלקטרוני שלך.</string>
    <string name="pp_contact">יצירת קשר</string>
    <string name="pp_contact_desc">אם יש לך שאלות לגבי מדיניות פרטיות זו, ניתן ליצור איתי קשר בדואר אלקטרוני בכתובת privacy@kavish.xyz.</string>
